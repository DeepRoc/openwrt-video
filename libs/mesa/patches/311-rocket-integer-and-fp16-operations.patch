+bool rkt_validate_float_domain(struct rkt_ml_subgraph *s, struct rkt_operation *o)
+{
+   if (o->float_aux != RKT_FLOAT_SQRT && o->float_aux != RKT_FLOAT_RSQRT && o->float_aux != RKT_FLOAT_DIV) return true;
+   struct pipe_resource *res = o->float_aux == RKT_FLOAT_DIV ? o->conv_side : o->conv_input;
+   struct pipe_transfer *tr = NULL;
+   const uint16_t *data = pipe_buffer_map(s->context, res, PIPE_MAP_READ, &tr);
+   if (!data) return false;
+   bool valid = true;
+   unsigned h = fp16_extent(o->input_height, o->fp16_global_input);
+   unsigned w = fp16_extent(o->input_width, o->fp16_global_input);
+   for (unsigned y=0; valid && y<o->input_height; y++)
+      for (unsigned x=0; valid && x<o->input_width; x++)
+         for (unsigned c=0; c<o->input_channels; c++) {
+            uint16_t bits = data[cube(h,w,c,y+o->fp16_global_input,x+o->fp16_global_input,8)];
