+      return !memcmp(a->dims,b->dims,sizeof(a->dims)) && alpha->dims[0]==1 && alpha->dims[1]==1 && alpha->dims[2]==1 && alpha->dims[3]==a->dims[3];
+   }
+   if(kind==RKT_FLOAT_MAX_POOL) return p->pooling.type==PIPE_ML_POOLING_TYPE_MAX && p->pooling.filter_width==2 && p->pooling.filter_height==2 && p->pooling.stride_x==2 && p->pooling.stride_y==2 && !p->pooling.padding_left && !p->pooling.padding_top && !p->pooling.padding_bottom && !p->pooling.padding_right && a->dims[1]==2*b->dims[1] && a->dims[2]==2*b->dims[2] && a->dims[3]==b->dims[3];
