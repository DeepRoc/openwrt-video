+   case PIPE_ML_OPERATION_TYPE_SQRT:return RKT_FLOAT_SQRT;
+   case PIPE_ML_OPERATION_TYPE_RSQRT:return RKT_FLOAT_RSQRT;
+   case PIPE_ML_OPERATION_TYPE_STRIDED_SLICE:return RKT_FLOAT_SLICE;
+   case PIPE_ML_OPERATION_TYPE_DIV:return RKT_FLOAT_DIV;
+   case PIPE_ML_OPERATION_TYPE_NEG:return RKT_FLOAT_NEG;
+   case PIPE_ML_OPERATION_TYPE_SUBTRACT:return RKT_FLOAT_SUB;
+   case PIPE_ML_OPERATION_TYPE_SQUARED_DIFFERENCE:return RKT_FLOAT_SQUARED_DIFF;
+   case PIPE_ML_OPERATION_TYPE_LEAKY_RELU:return RKT_FLOAT_PRELU;
+   case PIPE_ML_OPERATION_TYPE_POOLING:return RKT_FLOAT_MAX_POOL;
+   case PIPE_ML_OPERATION_TYPE_PAD:return RKT_FLOAT_PAD;
+   case PIPE_ML_OPERATION_TYPE_LOGISTIC:return RKT_FLOAT_SIGMOID;
+   case PIPE_ML_OPERATION_TYPE_RESHAPE:return RKT_FLOAT_RESHAPE;
