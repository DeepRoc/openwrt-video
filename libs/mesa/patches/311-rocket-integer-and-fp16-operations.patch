+/* SPDX-License-Identifier: MIT */
+#ifndef RKT_FLOAT_DOMAIN_H
+#define RKT_FLOAT_DOMAIN_H
+#include <stdbool.h>
+#include <stdint.h>
+/* The LUT index is the unsigned encoding of a nonnegative finite FP16 value.
+ * Zero is valid for sqrt, but not for reciprocal or reciprocal sqrt. */
+static inline bool
+rkt_float_lut_input_valid(uint16_t bits, bool allow_zero)
+{
+   return bits < UINT16_C(0x7c00) && (allow_zero || bits != 0);
+}
+#endif
--- /dev/null
+++ b/src/gallium/drivers/rocket/rkt_float_ops.c
@@ -0,0 +1,907 @@
+/* SPDX-License-Identifier: MIT
+ * FP16 convolution support with per-operation packed buffers. Host work is packing, padding,
+ * FP16 conversion and output reordering; CNA/CORE/DPU perform all arithmetic.
+ */
+#include "pipe/p_state.h"
+#include <errno.h>
+#include "rkt_float_domain.h"
+#include <math.h>
+#include <arm_neon.h>
+#include "util/u_inlines.h"
+#include "rkt_ml.h"
+#include "rkt_registers.h"
+#include "rkt_float_ops.h"
+#include "rkt_float_tile_registers.h"
+
+/* A pointwise convolution still issues at least four rows/columns. A shared
+ * C8 surface must reserve those rows even when the logical tensor is 1xW.
+ * Existing >=4 spatial surfaces keep exactly their previous strides. */
+#define RKT_FLOAT_MAX_VECTOR_WIDTH 97u
+#define RKT_FLOAT_MAX_VECTOR_CHANNELS 544u
+#define RKT_FLOAT_MAX_INPUT_CHANNELS 2304u
+
+static unsigned fp16_extent(unsigned n, bool global)
+{
+   return global ? MAX2(n, 4) + 2 : n;
+}
+static bool fp16_small(unsigned h, unsigned w)
+{
+   return h == 1 && w <= RKT_FLOAT_MAX_VECTOR_WIDTH;
+}
+
+/* Shape limits below bound the implemented tiling/layout paths. They are
+ * conservative validated limits, not advertised hardware maxima. CBUF bank
+ * calculations additionally enforce the physical twelve-bank capacity.
+ * Expand these limits only with boundary/layout tests and numerical validation. */
+static bool fp32(const struct pipe_tensor *t)
+{
+   return t && t->is_float && t->type_size == 4;
+}
+
+static size_t cube(unsigned h, unsigned w, unsigned c, unsigned y,
+                   unsigned x, unsigned atom)
+{
+   return (((size_t)(c / atom) * h + y) * w + x) * atom + c % atom;
+}
+
+/* Choose a tile that fits both input and weights in the physical CBUF.
+ * Depthwise consumes and produces the same channel vector: keep that vector
+ * together rather than reusing the dense output-channel slicing convention. */
+static bool
+float_conv_tile(const struct pipe_ml_operation *p, unsigned *rows_out,
+                unsigned *channels_out)
+{
+   unsigned ic = align(p->input_tensors[0]->dims[3], 32);
+   unsigned oc = align(p->output_tensors[0]->dims[3], 16);
+   unsigned kh = p->conv.weight_tensor->dims[1];
+   unsigned oh = p->output_tensors[0]->dims[1];
+   unsigned ow = p->output_tensors[0]->dims[2];
+   unsigned stride = p->conv.stride_y;
+   bool dw = p->conv.depthwise;
+   bool global = p->input_tensors[0]->dims[1] >= 4 &&
+                 p->input_tensors[0]->dims[2] >= 4 && oh >= 4 && ow >= 4;
+   unsigned channels = dw ? ic : (kh == 3 && ic > 128 ? 64 : 128);
+   for (; channels >= 16; channels /= 2) {
+      unsigned weights = kh * kh * ic * (dw ? 1 : MIN2(channels, oc)) * 2;
+      for (unsigned rows = 32; rows >= 4; rows /= 2) {
+         unsigned ih = (MAX2(4, MIN2(rows, oh)) - 1) * stride + kh;
+         unsigned iw = global ? fp16_extent(p->input_tensors[0]->dims[2], true) :
+                       (MAX2(4, MIN2(160, ow)) - 1) * stride + kh;
+         unsigned input = ih * iw * ic * 2;
+         if (DIV_ROUND_UP(input, CBUF_BANK_SIZE) +
+             DIV_ROUND_UP(weights, CBUF_BANK_SIZE) <= CBUF_BANKS) {
+            *rows_out = rows;
+            *channels_out = channels;
+            return true;
+         }
+      }
+      if (dw)
+         break;
+   }
+   return false;
+}
+
+bool
+rkt_float_conv_supported(const struct pipe_ml_operation *p)
+{
+   const struct pipe_tensor *in = p->input_tensors[0];
+   const struct pipe_tensor *out = p->output_tensors[0];
+   const struct pipe_tensor *w = p->conv.weight_tensor;
+   const struct pipe_tensor *b = p->conv.bias_tensor;
+   if (!fp32(in) || !fp32(out) || !fp32(w) || !fp32(b) ||
+       !w->data || !b->data || in->dims[0] != 1 || out->dims[0] != 1)
+      return false;
+   unsigned ic = in->dims[3], oc = out->dims[3], kh = w->dims[1], kw = w->dims[2];
+   unsigned sy = p->conv.stride_y, sx = p->conv.stride_x;
+   unsigned oh = out->dims[1], ow = out->dims[2];
+   bool dw = p->conv.depthwise;
+   if (!ic || ic > RKT_FLOAT_MAX_INPUT_CHANNELS || !oc || oc > 1536 || kh != kw || (kh < 1 || kh > 3) ||
+       sx != sy || (sy != 1 && sy != 2) ||
+       p->conv.dilation_width_factor != 1 || p->conv.dilation_height_factor != 1 ||
+       !oh || oh > 320 || !ow || ow > 320 ||
+       in->dims[1] > 642 || in->dims[2] > 642 ||
+       p->conv.padding_top > 1 || p->conv.padding_bottom > 1 ||
+       p->conv.padding_left > 1 || p->conv.padding_right > 1 ||
+       b->dims[0] != 1 || b->dims[1] != 1 || b->dims[2] != 1 || b->dims[3] != oc ||
+       w->dims[3] != ic || w->dims[0] != (dw ? 1 : oc) ||
+       (dw && (ic != oc || kh != 3)))
+      return false;
+   unsigned padded_h = in->dims[1] + p->conv.padding_top + p->conv.padding_bottom;
+   unsigned padded_w = in->dims[2] + p->conv.padding_left + p->conv.padding_right;
+   if (padded_h < kh || padded_w < kw ||
+       (padded_h - kh) / sy + 1 != oh || (padded_w - kw) / sx + 1 != ow)
+      return false;
+
+   unsigned rows, channels;
+   return float_conv_tile(p, &rows, &channels);
+}
+
+bool
+rkt_lower_float_conv(struct rkt_ml_subgraph *s,
+                    const struct pipe_ml_operation *p, struct rkt_operation *o)
+{
+   const struct pipe_tensor *in = p->input_tensors[0];
+   const struct pipe_tensor *out = p->output_tensors[0];
+   const struct pipe_tensor *w = p->conv.weight_tensor;
+   const struct pipe_tensor *b = p->conv.bias_tensor;
+   if (!rkt_float_conv_supported(p)) return false;
+   unsigned ic = in->dims[3], oc = out->dims[3], kh = w->dims[1], kw = w->dims[2];
+   unsigned sy = p->conv.stride_y, sx = p->conv.stride_x;
+   unsigned oh = out->dims[1], ow = out->dims[2];
+   bool dw = p->conv.depthwise;
+   unsigned tile_rows, channels_per_task;
+   if (!float_conv_tile(p, &tile_rows, &channels_per_task))
+      return false;
+   o->float_conv_f16 = true;
+   o->depthwise = dw;
+   o->conv_output_f16 = true;
+   o->conv_relu = p->conv.relu;
+   o->conv_physical_ic = align(ic, 32);
+   o->conv_physical_oc = dw ? o->conv_physical_ic : align(oc, 16);
+   o->conv_tiles_y = DIV_ROUND_UP(oh, tile_rows);
+   o->conv_tiles_x = DIV_ROUND_UP(ow, 160);
+   o->input_index = in->index; o->output_index = out->index;
+   o->input_height = in->dims[1]; o->input_width = in->dims[2]; o->input_channels = ic;
+   o->output_height = oh; o->output_width = ow; o->output_channels = oc;
+   o->weights_height = kh; o->weights_width = kw; o->stride = sy;
+   o->padding_top = p->conv.padding_top; o->padding_left = p->conv.padding_left;
+   o->tasks = UTIL_DYNARRAY_INIT;
+   unsigned weight_bytes = kh * kw * o->conv_physical_ic * (dw ? 1 : o->conv_physical_oc) * 2;
+   for (unsigned channel = 0; channel < o->conv_physical_oc; channel += channels_per_task) {
+   for (unsigned y = 0; y < oh; y += tile_rows) {
+      for (unsigned x = 0; x < ow; x += 160) {
+         struct split_task t = {0};
+         t.num = util_dynarray_num_elements(&o->tasks, struct split_task);
+         /* The hardware tile is at least 4x4. Overlap the final tile instead
+          * of writing beyond a global surface when its tail is 1..3 pixels. */
+         t.conv_y = MIN2(y, oh > 4 ? oh - 4 : 0);
+         t.conv_x = MIN2(x, ow > 4 ? ow - 4 : 0);
+         t.conv_c = channel;
+         t.output_channels = MIN2(channels_per_task, o->conv_physical_oc-channel);
+         t.output_height = MAX2(4, MIN2(tile_rows, oh - t.conv_y)); t.output_width = MAX2(4, MIN2(160, ow - t.conv_x));
+         t.input_height = (t.output_height - 1) * sy + kh;
+         t.input_width = (t.output_width - 1) * sx + kw;
+         t.conv_input_bytes = t.input_height * t.input_width * o->conv_physical_ic * 2;
+         t.conv_output_bytes = t.output_height * t.output_width * t.output_channels * (o->conv_output_f16 ? 2 : 4);
+         t.input_banks = DIV_ROUND_UP(t.conv_input_bytes, CBUF_BANK_SIZE);
+         unsigned tile_weight_bytes=kh*kw*o->conv_physical_ic*(dw ? 1 : t.output_channels)*2;
+         if (t.input_height < 4 || t.input_banks + DIV_ROUND_UP(tile_weight_bytes, CBUF_BANK_SIZE) > CBUF_BANKS)
+            goto fail;
+         t.weights_banks = CBUF_BANKS - t.input_banks;
+         t.input_offset = o->conv_input_bytes; t.output_offset = o->conv_output_bytes;
+         o->conv_input_bytes += align(t.conv_input_bytes + FLOAT_GUARD, 4096);
+         o->conv_output_bytes += align(t.conv_output_bytes + FLOAT_GUARD, 4096);
+         util_dynarray_append(&o->tasks, t);
+      }
+   }
+
+   }
+
+   /* Global C8 cube with a one-pixel zero border. Tile views read/write it
+    * with explicit line/surface strides; the model's logical shape is unchanged. */
+   o->fp16_global=((in->dims[1]>=4 && in->dims[2]>=4 && oh>=4 && ow>=4) ||
+       (!o->reduce_spatial && kh==1 && kw==1 && sx==1 && sy==1 &&
+        fp16_small(in->dims[1],in->dims[2]) && fp16_small(oh,ow) &&
+        DIV_ROUND_UP(4*fp16_extent(in->dims[2],true)*o->conv_physical_ic*2,CBUF_BANK_SIZE) +
+        DIV_ROUND_UP(o->conv_physical_ic*MIN2(channels_per_task,o->conv_physical_oc)*2,CBUF_BANK_SIZE) <= CBUF_BANKS));
+   o->fp16_global_input=o->fp16_global;
+   o->fp16_global_output=o->fp16_global;
+   if(o->fp16_global_input) o->conv_input_bytes=(fp16_extent(o->input_height,true))*(fp16_extent(o->input_width,true))*o->conv_physical_ic*2+FLOAT_GUARD;
+   if(o->fp16_global_output) o->conv_output_bytes=fp16_extent(oh,true)*fp16_extent(ow,true)*align(oc,32)*2+FLOAT_GUARD;
+   util_dynarray_foreach(&o->tasks,struct split_task,t) {
+      if(o->fp16_global_input) {
+         t->input_banks=DIV_ROUND_UP(t->input_height*(fp16_extent(o->input_width,true))*o->conv_physical_ic*2,CBUF_BANK_SIZE);
+         unsigned wb=kh*kw*o->conv_physical_ic*(dw ? 1 : t->output_channels)*2;
+         if(t->input_banks+DIV_ROUND_UP(wb,CBUF_BANK_SIZE)>CBUF_BANKS) goto fail;
+         t->weights_banks=CBUF_BANKS-t->input_banks;
+      }
+      if(o->fp16_global_input) t->input_offset=((t->conv_y*sy+1-o->padding_top)*(fp16_extent(o->input_width,true))+t->conv_x*sx+1-o->padding_left)*16;
+      if(o->fp16_global_output) t->output_offset=((t->conv_y+1)*fp16_extent(ow,true)+t->conv_x+1)*16+t->conv_c/8*fp16_extent(oh,true)*fp16_extent(ow,true)*16;
+   }
+
+   struct pipe_context *ctx = s->context;
+   struct pipe_transfer *transfer = NULL;
+   o->weights = pipe_buffer_create(ctx->screen, 0, PIPE_USAGE_DEFAULT, weight_bytes + FLOAT_GUARD);
+   o->biases = pipe_buffer_create(ctx->screen, 0, PIPE_USAGE_DEFAULT, o->conv_physical_oc * 4 + FLOAT_GUARD);
+   o->conv_input = pipe_buffer_create(ctx->screen, 0, PIPE_USAGE_DEFAULT, o->conv_input_bytes);
+   o->conv_output = pipe_buffer_create(ctx->screen, 0, PIPE_USAGE_DEFAULT, o->conv_output_bytes);
+   if (!o->weights || !o->biases || !o->conv_input || !o->conv_output)
+      goto fail;
+   _Float16 *weights = pipe_buffer_map(ctx, o->weights, PIPE_MAP_WRITE, &transfer);
+   if (!weights)
+      goto fail;
+   memset(weights, 0, pipe_buffer_size(o->weights));
+   const float *source = (const void *)w->data;
+   for (unsigned y = 0; y < kh; y++)
+      for (unsigned x = 0; x < kw; x++)
+         for (unsigned c = 0; c < oc; c++) {
+            if (dw) {
+               size_t dst = (((c / 32) * kh + y) * kw + x) * 32 + c % 32;
+               weights[dst] = (_Float16)source[(y * kw + x) * ic + c];
+            } else {
+               for (unsigned k = 0; k < ic; k++) {
+                  size_t dst = ((((((c / 16) * (o->conv_physical_ic / 32) + k / 32) * kh + y) * kw + x) * 16 + c % 16) * 32 + k % 32);
+                  weights[dst] = (_Float16)source[((c * kh + y) * kw + x) * ic + k];
+               }
+            }
+         }
+   if (DBG_ENABLED(ROCKET_DBG_DUMP_BOS))
+      rkt_dump_buffer((void *)weights, "float-weights", 0, 0, 0, pipe_buffer_size(o->weights));
+   pipe_buffer_unmap(ctx, transfer);
+   void *biases = pipe_buffer_map(ctx, o->biases, PIPE_MAP_WRITE, &transfer);
+   if (!biases)
+      goto fail;
+   memset(biases, 0, pipe_buffer_size(o->biases));
+   memcpy(biases, b->data, oc * sizeof(float));
+   pipe_buffer_unmap(ctx, transfer);
+   DBG("rocket: %s FP16-input conv %ux%ux%u -> %ux%ux%u; "
+           "%u NPU tiles; FP32 bias, %s output, ReLU=%u\n", dw ? "native-depthwise" : "direct",
+           o->input_height, o->input_width, ic, oh, ow, oc,
+           util_dynarray_num_elements(&o->tasks, struct split_task), o->conv_output_f16 ? "FP16" : "FP32", o->conv_relu);
+   return true;
+fail:
+   pipe_resource_reference(&o->conv_input, NULL);
+   pipe_resource_reference(&o->conv_output, NULL);
+   pipe_resource_reference(&o->weights, NULL);
+   pipe_resource_reference(&o->biases, NULL);
+   util_dynarray_fini(&o->tasks);
+   return false;
+}
+
+/* Same NHWC -> C8/FP16 mapping as cube(), with a one-pixel halo.
+ * Four RGB pixels are converted together; inactive lanes remain zero. */
+static void
+pack_global_vector(_Float16 *dst, const float *input, unsigned h, unsigned w, unsigned channels)
+{
+   for (unsigned y=0;y<h;y++) {
+      unsigned x=0;
+      if(channels==3) {
+         for(;x+4<=w;x+=4) {
+            float32x4x3_t rgb=vld3q_f32(input+((size_t)y*w+x)*3);
+            uint16x4_t r=vreinterpret_u16_f16(vcvt_f16_f32(rgb.val[0]));
+            uint16x4_t g=vreinterpret_u16_f16(vcvt_f16_f32(rgb.val[1]));
+            uint16x4_t b=vreinterpret_u16_f16(vcvt_f16_f32(rgb.val[2]));
+            uint16x4_t z=vdup_n_u16(0);
+            uint32x2_t rg0=vreinterpret_u32_u16(vzip1_u16(r,g));
+            uint32x2_t rg1=vreinterpret_u32_u16(vzip2_u16(r,g));
+            uint32x2_t bz0=vreinterpret_u32_u16(vzip1_u16(b,z));
+            uint32x2_t bz1=vreinterpret_u32_u16(vzip2_u16(b,z));
+            uint16_t *out=(uint16_t *)(dst+cube(fp16_extent(h,true),fp16_extent(w,true),0,y+1,x+1,8));
+            vst1q_u16(out,    vcombine_u16(vreinterpret_u16_u32(vzip1_u32(rg0,bz0)),z));
+            vst1q_u16(out+8,  vcombine_u16(vreinterpret_u16_u32(vzip2_u32(rg0,bz0)),z));
+            vst1q_u16(out+16, vcombine_u16(vreinterpret_u16_u32(vzip1_u32(rg1,bz1)),z));
+            vst1q_u16(out+24, vcombine_u16(vreinterpret_u16_u32(vzip2_u32(rg1,bz1)),z));
+         }
+      }
+      for(;x<w;x++) {
+         const float *pixel=input+((size_t)y*w+x)*channels;
+         unsigned c=0;
+         for(;c+8<=channels;c+=8) {
+            float16x8_t v=vcombine_f16(vcvt_f16_f32(vld1q_f32(pixel+c)),vcvt_f16_f32(vld1q_f32(pixel+c+4)));
+            vst1q_u16((uint16_t *)(dst+cube(fp16_extent(h,true),fp16_extent(w,true),c,y+1,x+1,8)),vreinterpretq_u16_f16(v));
+         }
+         for(;c<channels;c++) dst[cube(fp16_extent(h,true),fp16_extent(w,true),c,y+1,x+1,8)]=(_Float16)pixel[c];
+      }
+   }
+}
+
+void
+rkt_upload_float_conv(struct rkt_ml_subgraph *s, struct rkt_operation *o, const float *input)
+{
+   struct pipe_context *ctx = s->context;
+   struct pipe_transfer *transfer = NULL;
+   struct pipe_resource *r = o->conv_input;
+   uint64_t t0 = rkt_profile_ns();
+   uint8_t *raw = pipe_buffer_map(ctx, r, PIPE_MAP_WRITE, &transfer);
+   if (!raw) return;
+   o->profile[0] = rkt_profile_ns() - t0; t0 = rkt_profile_ns();
+   /* This private DMA source is never written by the NPU. Shape is fixed,
+    * every logical element is replaced below, and padding remains zero. */
+   if(!o->input_padding_initialized)
+      memset(raw, 0, pipe_buffer_size(r));
+   o->input_padding_initialized=true;
+   o->profile[1] = rkt_profile_ns() - t0; t0 = rkt_profile_ns();
+   if(o->fp16_global_input) {
+      _Float16 *dst=(void *)raw;
+       pack_global_vector(dst,input,o->input_height,o->input_width,o->input_channels);
+   } else
+   util_dynarray_foreach (&o->tasks, struct split_task, t) {
+      _Float16 *tile = (void *)(raw + t->input_offset);
+      for (unsigned y = 0; y < t->input_height; y++)
+         for (unsigned x = 0; x < t->input_width; x++) {
+            int iy = (int)(t->conv_y * o->stride + y) - (int)o->padding_top;
+            int ix = (int)(t->conv_x * o->stride + x) - (int)o->padding_left;
+            if (iy < 0 || ix < 0 || iy >= o->input_height || ix >= o->input_width) continue;
+            if(o->reduce_spatial) {
+               /* Reorder coordinates only. Reduction arithmetic is the MAC. */
+               for(unsigned c=0;c<o->input_channels;c++)
+                  tile[cube(t->input_height,t->input_width,c,y,x,8)]=(_Float16)input[c*o->input_width+ix];
+               continue;
+            }
+            const float *pixel = input + ((size_t)iy * o->input_width + ix) * o->input_channels;
+            unsigned c = 0;
+            for (; c + 8 <= o->input_channels; c += 8) {
+               float16x8_t v = vcombine_f16(vcvt_f16_f32(vld1q_f32(pixel+c)),
+                                           vcvt_f16_f32(vld1q_f32(pixel+c+4)));
+               vst1q_u16((uint16_t *)(tile+cube(t->input_height,t->input_width,c,y,x,8)), vreinterpretq_u16_f16(v));
+            }
+            for (; c < o->input_channels; c++)
+               tile[cube(t->input_height, t->input_width, c, y, x, 8)] = (_Float16)pixel[c];
+         }
+   }
+   o->profile[2] = rkt_profile_ns() - t0; t0 = rkt_profile_ns();
+   if (DBG_ENABLED(ROCKET_DBG_DUMP_BOS))
+      rkt_dump_buffer(raw, "float-input", 0, 0, 0, pipe_buffer_size(r));
+   pipe_buffer_unmap(ctx, transfer);
+   o->profile[3] = rkt_profile_ns() - t0; t0 = rkt_profile_ns();
+   rkt_prepare_float_output(s,o);
+}
+
+void
+rkt_prepare_float_output(struct rkt_ml_subgraph *s,struct rkt_operation *o)
+{
+   if(o->fp16_global_output && o->fp16_output_initialized) return;
+   o->fp16_output_initialized=true;
+   struct pipe_context *ctx=s->context;
+   struct pipe_resource *r=o->conv_output;
+   struct pipe_transfer *transfer=NULL;
+   uint64_t t0=rkt_profile_ns();
+   uint8_t *raw = pipe_buffer_map(ctx, r, PIPE_MAP_WRITE, &transfer);
+   if (!raw) return;
+   o->profile[4] = rkt_profile_ns() - t0; t0 = rkt_profile_ns();
+   memset(raw, 0xa5, pipe_buffer_size(r));
+   if(o->fp16_global_output) memset(raw,0,pipe_buffer_size(r)-FLOAT_GUARD);
+   pipe_buffer_unmap(ctx, transfer);
+   o->profile[5] = rkt_profile_ns() - t0;
+}
+
+void
+rkt_check_float_guards(struct rkt_operation *o,const uint8_t *raw)
+{
+   if(o->fp16_global_output) {
+      for(unsigned b=o->conv_output_bytes-FLOAT_GUARD;b<o->conv_output_bytes;b++) if(raw[b]!=0xa5) {fprintf(stderr,"global guard corrupt %u\n",b);o->error = EIO; return;}
+      return;
+   }
+   bool vector=true;
+   util_dynarray_foreach (&o->tasks,struct split_task,t) {
+      const uint8_t *tile=raw+t->output_offset;
+      unsigned b=t->conv_output_bytes,end=align(b+FLOAT_GUARD,4096);
+      if (vector) {
+         const uint8x16_t expected=vdupq_n_u8(0xa5);
+         for (;b+16<=end;b+=16) {
+            uint8x16_t different=veorq_u8(vld1q_u8(tile+b),expected);
+            if (vmaxvq_u8(different)) {
+               fprintf(stderr,"rocket: output guard overwritten: tile=%u block=%u\n",t->num,b);
+               o->error = EIO; return;
+            }
+         }
+      }
+      for (;b<end;b++) {
+         if (tile[b] != 0xa5) {
+            fprintf(stderr,"rocket: output guard overwritten: tile=%u byte=%u\n",t->num,b);
+            o->error = EIO; return;
+         }
+      }
+   }
+}
+
+void
+rkt_read_float_conv(struct rkt_operation *o, const uint8_t *raw, float *output)
+{
+   rkt_check_float_guards(o,raw);
+   if (o->error) return;
+   if(o->fp16_global_output) {
+      const _Float16 *src=(const void *)raw;
+      for(unsigned y=0;y<o->output_height;y++) for(unsigned x=0;x<o->output_width;x++) for(unsigned c=0;c<o->output_channels;c++)
+         output[(y*o->output_width+x)*o->output_channels+c]=(float)src[cube(fp16_extent(o->output_height,true),fp16_extent(o->output_width,true),c,y+1,x+1,8)];
+      return;
+   }
+   util_dynarray_foreach (&o->tasks, struct split_task, t) {
+      const uint8_t *tile = raw + t->output_offset;
+      for (unsigned y = 0; y < t->output_height && y + t->conv_y < o->output_height; y++)
+         for (unsigned x = 0; x < t->output_width && x + t->conv_x < o->output_width; x++) {
+            float *pixel = output + (((size_t)t->conv_y+y)*o->output_width+t->conv_x+x)*o->output_channels + t->conv_c;
+            unsigned channels=MIN2(t->output_channels,o->output_channels-t->conv_c);
+            unsigned c = 0;
+            if (o->conv_output_f16) {
+               for (; c + 8 <= channels; c += 8) {
+                  const uint16_t *src = (const uint16_t *)tile+cube(t->output_height,t->output_width,c,y,x,8);
+                  float16x8_t h = vreinterpretq_f16_u16(vld1q_u16(src));
+                  vst1q_f32(pixel+c,vcvt_f32_f16(vget_low_f16(h)));
+                  vst1q_f32(pixel+c+4,vcvt_f32_f16(vget_high_f16(h)));
+               }
+               for (; c < channels; c++)
+                  pixel[c] = (float)((const _Float16 *)tile)[cube(t->output_height,t->output_width,c,y,x,8)];
+            } else {
+               for (; c + 4 <= channels; c += 4) {
+                  const float *src = (const float *)tile+cube(t->output_height,t->output_width,c,y,x,4);
+                  vst1q_f32(pixel+c,vld1q_f32(src));
+               }
+               for (; c < channels; c++)
+                  pixel[c] = ((const float *)tile)[cube(t->output_height,t->output_width,c,y,x,4)];
+            }
+         }
+   }
+   if (getenv("ROCKET_VALIDATE_VERBOSE")) fprintf(stderr, "rocket: completed FP16 convolution: %u output values; tile guards intact\n",
+           o->output_height * o->output_width * o->output_channels);
+}
+
+void
+rkt_fill_float_conv_regcmd(struct rkt_ml_subgraph *s, const struct rkt_operation *o,
+                         struct util_dynarray *regs, unsigned task_num)
+{
+   const struct split_task *t = util_dynarray_element(&o->tasks, struct split_task, task_num);
+   unsigned ic = o->conv_physical_ic, oc = t->output_channels;
+   unsigned ih = t->input_height, iw = t->input_width;
+   unsigned oh = t->output_height, ow = t->output_width;
+   unsigned kh = o->weights_height, kw = o->weights_width;
+   unsigned kernels = o->depthwise ? 1 : oc;
+   unsigned mode = o->depthwise ? 3 : 0;
+   /* Native direct FP16 writes two-byte values; depthwise retains its
+    * independently validated four-byte stride geometry. */
+   unsigned output_stride_bytes = o->conv_output_f16 && !o->depthwise ? 2 : 4;
+   unsigned size_e = output_stride_bytes - 1;
+   /* The capture supplies initialization/reset values and ordering. Every shape,
+    * precision, activation and address field below is parameterized from the
+    * MIT register definitions / RK3588 TRM and checked against hardware captures.
+    * Native DW FP32 output is unvalidated: only its verified FP16 writer is used.
+    * CPEND must be bypassed when enabling the FP32 bias ALU: the native DW
+    * control changes from Inf/wrong values to exact FP16 results with this bit.
+    */
+   for (unsigned n = 0; n < ARRAY_SIZE(float_tile_registers); n++) {
+      uint64_t reg = float_tile_registers[n];
+      uint64_t value = (reg >> 16) & UINT32_MAX;
+      switch (reg & 0xffff) {
+      case 0x100c: value = CNA_CONV_CON1_CONV_MODE(mode) | CNA_CONV_CON1_IN_PRECISION(2) | CNA_CONV_CON1_PROC_PRECISION(2); break;
+      case 0x1010: value = CNA_CONV_CON2_FEATURE_GRAINS(o->depthwise ? 52 : ih + 1); break;
+      case 0x1014: value = CNA_CONV_CON3_CONV_X_STRIDE(o->stride) | CNA_CONV_CON3_CONV_Y_STRIDE(o->stride); break;
+      case 0x1020: value = CNA_DATA_SIZE0_DATAIN_WIDTH(o->fp16_global_input ? fp16_extent(o->input_width,true) : iw) | CNA_DATA_SIZE0_DATAIN_HEIGHT(ih); break;
+      case 0x1024: value = CNA_DATA_SIZE1_DATAIN_CHANNEL_REAL(ic - 1) | CNA_DATA_SIZE1_DATAIN_CHANNEL(ic); break;
+      case 0x1028: value = ow; break;
+      case 0x102c: value = oh * ow; break;
+      case 0x1030: value = kh * kw * ic * kernels * 2; break;
+      case 0x1034: value = kh * kw * ic * 2; break;
+      case 0x1038: value = CNA_WEIGHT_SIZE2_WEIGHT_WIDTH(kw) | CNA_WEIGHT_SIZE2_WEIGHT_HEIGHT(kh) | CNA_WEIGHT_SIZE2_WEIGHT_KERNELS(kernels); break;
+      case 0x1040: value = CNA_CBUF_CON0_WEIGHT_BANK(t->weights_banks) | CNA_CBUF_CON0_DATA_BANK(t->input_banks); break;
+      case 0x1044: value = DIV_ROUND_UP((o->fp16_global_input ? fp16_extent(o->input_width,true) : iw) * ic, 32); break;
+      case 0x1070: value = rkt_resource(o->conv_input)->phys_addr + t->input_offset; break;
+      case 0x107c: value = (o->fp16_global_input ? fp16_extent(o->input_width,true) : iw) * 4; break;
+      case 0x1080: value = o->fp16_global_input ? (fp16_extent(o->input_width,true))*(fp16_extent(o->input_height,true)-4) : iw * (ih - 4); break;
+      case 0x1084: value = CNA_FC_DATA_SIZE0_DMA_WIDTH(o->fp16_global_input ? fp16_extent(o->input_width,true) : iw) | CNA_FC_DATA_SIZE0_DMA_HEIGHT(ih); break;
+      case 0x1088: value = ic; break;
+      case 0x1110: value = rkt_resource(o->weights)->phys_addr + t->conv_c*kh*kw*ic*2; break;
+      case 0x3010: value = CORE_MISC_CFG_PROC_PRECISION(2) | CORE_MISC_CFG_QD_EN(1) | CORE_MISC_CFG_DW_EN(o->depthwise); break;
+      case 0x3014: value = CORE_DATAOUT_SIZE_0_DATAOUT_HEIGHT(oh - 1) | CORE_DATAOUT_SIZE_0_DATAOUT_WIDTH(ow - 1); break;
+      case 0x3018: value = oc - 1; break;
+      case 0x400c: value = DPU_FEATURE_MODE_CFG_BURST_LEN(15) | DPU_FEATURE_MODE_CFG_CONV_MODE(mode) | DPU_FEATURE_MODE_CFG_OUTPUT_MODE(2); break;
+      case 0x4010: value = DPU_DATA_FORMAT_OUT_PRECISION(o->conv_output_f16 ? 2 : 5) | DPU_DATA_FORMAT_IN_PRECISION(2) | DPU_DATA_FORMAT_PROC_PRECISION(2); break;
+      case 0x4020: value = rkt_resource(o->conv_output)->phys_addr + t->output_offset; break;
+      case 0x4024: value = DPU_DST_SURF_STRIDE_DST_SURF_STRIDE(o->fp16_global_output ? (fp16_extent(o->output_height,true))*(fp16_extent(o->output_width,true)) : oh * ow); break;
+      case 0x4030: case 0x500c: value = ow - 1; break;
+      case 0x4034: case 0x5010: value = oh - 1; break;
+      case 0x4038: if(o->fp16_global_output) {unsigned gap=fp16_extent(o->output_width,true)-ow;value=gap|(gap<<16);} break;
+      case 0x403c: value = DPU_DATA_CUBE_CHANNEL_ORIG_CHANNEL(oc - 1) | DPU_DATA_CUBE_CHANNEL_CHANNEL(oc - 1); break;
