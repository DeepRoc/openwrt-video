+/* Standalone native INT8 max pool, canonical C16 cubes. Requires the
+ * temporary kernel's standalone_ppu completion mode. */
+static void
+fill_pool_regcmd(struct rkt_ml_subgraph *sg, const struct rkt_operation *op,
+                struct util_dynarray *regs, unsigned task_num)
+{
+   struct split_task *task = util_dynarray_element(&op->tasks, struct split_task, task_num);
+   unsigned iw = task->output_width * op->stride, ih = op->input_height;
+   unsigned ow = task->output_width, oh = op->output_height;
+   unsigned channels = op->input_channels;
+   EMIT(REG_PPU_S_POINTER, 0xe);
+   EMIT(REG_PPU_RDMA_RDMA_S_POINTER, 0xe);
+   EMIT(REG_PPU_DATA_CUBE_IN_WIDTH, iw - 1);
+   EMIT(REG_PPU_DATA_CUBE_IN_HEIGHT, ih - 1);
+   EMIT(REG_PPU_DATA_CUBE_IN_CHANNEL, channels - 1);
+   EMIT(REG_PPU_DATA_CUBE_OUT_WIDTH, ow - 1);
+   EMIT(REG_PPU_DATA_CUBE_OUT_HEIGHT, oh - 1);
+   EMIT(REG_PPU_DATA_CUBE_OUT_CHANNEL, channels - 1);
+   EMIT(REG_PPU_OPERATION_MODE_CFG, 0x11);
+   EMIT(REG_PPU_POOLING_KERNEL_CFG, (op->pool_width - 1) |
+        ((op->pool_height - 1) << 8) | ((op->stride - 1) << 16) |
+        ((op->pool_stride_y - 1) << 20));
+   EMIT(REG_PPU_RECIP_KERNEL_WIDTH, 0);
+   EMIT(REG_PPU_RECIP_KERNEL_HEIGHT, 0);
+   EMIT(REG_PPU_POOLING_PADDING_CFG, op->padding_left |
+        (op->padding_top << 4) | (op->padding_right << 8) | (op->padding_bottom << 12));
+   EMIT(REG_PPU_PADDING_VALUE_1_CFG, 0x7ff80);
+   EMIT(REG_PPU_PADDING_VALUE_2_CFG, 0);
+   EMIT(REG_PPU_DST_BASE_ADDR, (op->pool_scratch ? rkt_resource(op->pool_scratch)->phys_addr :
+        rkt_get_tensor(sg, op->output_index)->phys_addr));
+   EMIT(REG_PPU_DST_SURF_STRIDE, oh * ow * 16);
+   EMIT(REG_PPU_DATA_FORMAT, oh * ow * 16);
+   EMIT(REG_PPU_MISC_CTRL, 3);
+   EMIT(REG_PPU_RDMA_RDMA_CUBE_IN_WIDTH, iw - 1);
+   EMIT(REG_PPU_RDMA_RDMA_CUBE_IN_HEIGHT, ih - 1);
+   EMIT(REG_PPU_RDMA_RDMA_CUBE_IN_CHANNEL, channels - 1);
+   EMIT(REG_PPU_RDMA_RDMA_SRC_BASE_ADDR, rkt_get_tensor(sg, op->input_index)->phys_addr + task->input_offset);
+   EMIT(REG_PPU_RDMA_RDMA_SRC_LINE_STRIDE, op->input_width * 16);
+   EMIT(REG_PPU_RDMA_RDMA_SRC_SURF_STRIDE, ih * op->input_width * 16);
+   EMIT(REG_PPU_RDMA_RDMA_DATA_FORMAT, 1);
+   if (task_num + 1 < util_dynarray_num_elements(&op->tasks, struct split_task))
+      EMIT(REG_PC_BASE_ADDRESS, 0)
+   else
+      util_dynarray_append_typed(regs, uint64_t, 0);
+   EMIT(REG_PC_REGISTER_AMOUNTS, 0);
+   util_dynarray_append_typed(regs, uint64_t, 0x0041000000000000);
+   emit_raw(regs, 0x81, REG_PC_OPERATION_ENABLE, 0x60);
+}
+/* Integer DPU identity pass: join a packed PPU column tile into a C16 cube.
+ * Precision fields are INT8 throughout; BS, BN and EW arithmetic are bypassed. */
+static void
+fill_integer_dpu(struct rkt_ml_subgraph *sg, const struct rkt_operation *op,
+               struct util_dynarray *regs, unsigned task_num)
+{
+   struct split_task *task = util_dynarray_element(&op->tasks, struct split_task, task_num);
+   unsigned w = task->output_width, h = op->output_height, c = op->output_channels;
+   unsigned gap = op->output_width - w;
+   if (op->logistic || op->pad_copy) c = rkt_output_storage_channels(op);
+   if (op->pad_copy) h = op->input_height;
+   unsigned dst_surface = op->output_width * op->output_height * 16;
+   EMIT(REG_DPU_S_POINTER, 0xe);
+   EMIT(REG_DPU_RDMA_RDMA_S_POINTER, 0xe);
+   EMIT(REG_DPU_FEATURE_MODE_CFG, DPU_FEATURE_MODE_CFG_BURST_LEN(15) |
+        DPU_FEATURE_MODE_CFG_OUTPUT_MODE(2) | DPU_FEATURE_MODE_CFG_FLYING_MODE(1));
+   EMIT(REG_DPU_DATA_FORMAT, 0);
+   EMIT(REG_DPU_OFFSET_PEND, 0);
+   EMIT(REG_DPU_DST_BASE_ADDR, rkt_get_tensor(sg, op->output_index)->phys_addr + task->output_offset);
+   EMIT(REG_DPU_DST_SURF_STRIDE, dst_surface);
+   EMIT(REG_DPU_DATA_CUBE_WIDTH, w - 1);
+   EMIT(REG_DPU_DATA_CUBE_HEIGHT, h - 1);
+   EMIT(REG_DPU_DATA_CUBE_NOTCH_ADDR, gap | (gap << 16));
+   EMIT(REG_DPU_DATA_CUBE_CHANNEL, DPU_DATA_CUBE_CHANNEL_ORIG_CHANNEL(c - 1) |
+        DPU_DATA_CUBE_CHANNEL_CHANNEL(c - 1));
+   unsigned mul_a = op->integer_add ? lroundf(op->input_scale / op->output_scale * 32768) : 1;
+   unsigned mul_b = op->integer_add ? lroundf(op->addition_scale / op->output_scale * 32768) : 1;
+   EMIT(REG_DPU_BS_CFG, op->logistic ? DPU_BS_CFG_BS_ALU_ALGO(2) |
+        DPU_BS_CFG_BS_MUL_BYPASS(1) | DPU_BS_CFG_BS_RELU_BYPASS(1) : op->integer_add ? DPU_BS_CFG_BS_ALU_ALGO(2) |
+        DPU_BS_CFG_BS_RELU_BYPASS(1) : 0x53);
+   EMIT(REG_DPU_BS_ALU_CFG, op->logistic ? 128 : op->integer_add ? 128 - op->input_zero_point : 0);
+   EMIT(REG_DPU_BS_MUL_CFG, op->integer_add ? DPU_BS_MUL_CFG_BS_MUL_OPERAND(mul_a) : 0);
+   EMIT(REG_DPU_BS_OW_CFG, DPU_BS_OW_CFG_OD_BYPASS(1));
+   EMIT(REG_DPU_BS_OW_OP, 0);
+   EMIT(REG_DPU_WDMA_SIZE_0, c - 1);
+   EMIT(REG_DPU_WDMA_SIZE_1, DPU_WDMA_SIZE_1_WIDTH_WDMA(w - 1) |
+        DPU_WDMA_SIZE_1_HEIGHT_WDMA(h - 1));
+   EMIT(REG_DPU_BN_CFG, 0x53);
+   EMIT(REG_DPU_BN_ALU_CFG, 0);
+   EMIT(REG_DPU_BN_MUL_CFG, 0);
+   if (op->logistic) {
+      EMIT(REG_DPU_EW_CFG, DPU_EW_CFG_EW_RELU_BYPASS(1) |
+           DPU_EW_CFG_EW_OP_CVT_BYPASS(1) | DPU_EW_CFG_EW_OP_BYPASS(1));
+      for (unsigned table = 0; table < 2; table++) {
+         EMIT(REG_DPU_LUT_ACCESS_CFG, (1 << 17) | (table << 16));
+         for (unsigned i = 0; i <= 512; i++) {
+            unsigned value;
+            float x = ((float)i - op->input_zero_point) * op->input_scale;
+            value = CLAMP(lroundf(256 / (1 + expf(-x))), 0, 255) + 1;
+            EMIT(REG_DPU_LUT_ACCESS_DATA, value);
+         }
+      }
+      EMIT(REG_DPU_LUT_CFG, DPU_LUT_CFG_LUT_HYBRID_PRIORITY(1) |
+           DPU_LUT_CFG_LUT_OFLOW_PRIORITY(1) | DPU_LUT_CFG_LUT_LO_LE_MUX(2));
+      EMIT(REG_DPU_LUT_INFO, 0);
+      EMIT(REG_DPU_LUT_LE_START, 0);
+      EMIT(REG_DPU_LUT_LE_END, 512);
+      EMIT(REG_DPU_LUT_LO_START, 0);
+      EMIT(REG_DPU_LUT_LO_END, 512);
+      EMIT(REG_DPU_LUT_LE_SLOPE_SCALE, 0);
+      EMIT(REG_DPU_LUT_LE_SLOPE_SHIFT, 0);
+      EMIT(REG_DPU_LUT_LO_SLOPE_SCALE, 0);
+      EMIT(REG_DPU_LUT_LO_SLOPE_SHIFT, 0);
+   } else if (op->integer_add) {
+      EMIT(REG_DPU_EW_CFG, DPU_EW_CFG_EW_DATA_MODE(1) | DPU_EW_CFG_EDATA_SIZE(1) |
+           DPU_EW_CFG_EW_ALU_ALGO(2) | DPU_EW_CFG_EW_RELU_BYPASS(1) |
+           DPU_EW_CFG_EW_LUT_BYPASS(1) | DPU_EW_CFG_EW_OP_SRC(1));
+      /* EW offset is added after multiplication: measured with all INT8 pairs. */
+      EMIT(REG_DPU_EW_CVT_OFFSET_VALUE, (128 - op->addition_offset) * mul_b);
+      EMIT(REG_DPU_EW_CVT_SCALE_VALUE, mul_b);
+   } else {
+      EMIT(REG_DPU_EW_CFG, DPU_EW_CFG_EW_RELU_BYPASS(1) |
+           DPU_EW_CFG_EW_OP_CVT_BYPASS(1) | DPU_EW_CFG_EW_LUT_BYPASS(1) |
+           DPU_EW_CFG_EW_OP_BYPASS(1) | DPU_EW_CFG_EW_BYPASS(1));
+   }
+   EMIT(REG_DPU_OUT_CVT_OFFSET, op->logistic ? -129 : op->integer_add ? op->output_zero_point - 128 : 0);
+   EMIT(REG_DPU_OUT_CVT_SCALE, 1);
+   EMIT(REG_DPU_OUT_CVT_SHIFT, op->integer_add ? 15 : 0);
+   EMIT(REG_DPU_SURFACE_ADD, dst_surface);
+   emit_raw(regs, DPU | 1, 0x40c4, 0);
+   EMIT(REG_DPU_RDMA_RDMA_DATA_CUBE_WIDTH, w - 1);
+   EMIT(REG_DPU_RDMA_RDMA_DATA_CUBE_HEIGHT, h - 1);
+   EMIT(REG_DPU_RDMA_RDMA_DATA_CUBE_CHANNEL, c - 1);
+   EMIT(REG_DPU_RDMA_RDMA_SRC_BASE_ADDR, ((op->integer_add || op->logistic || op->pad_copy) ? rkt_get_tensor(sg, op->input_index)->phys_addr :
+        rkt_resource(op->pool_scratch)->phys_addr));
+   EMIT(REG_DPU_RDMA_RDMA_BRDMA_CFG, 1 /* BRDMA_DISABLE */);
+   EMIT(REG_DPU_RDMA_RDMA_NRDMA_CFG, 1 /* NRDMA_DISABLE */);
+   EMIT(REG_DPU_RDMA_RDMA_ERDMA_CFG, op->integer_add ?
+        DPU_RDMA_RDMA_ERDMA_CFG_ERDMA_DATA_MODE(1) | DPU_RDMA_RDMA_ERDMA_CFG_ERDMA_DATA_SIZE(1) :
+        DPU_RDMA_RDMA_ERDMA_CFG_ERDMA_DISABLE(1));
+   EMIT(REG_DPU_RDMA_RDMA_EW_BASE_ADDR, op->integer_add ? rkt_get_tensor(sg, op->add_tensor)->phys_addr : 0);
+   EMIT(REG_DPU_RDMA_RDMA_EW_SURF_STRIDE, op->integer_add ? w * h * 16 : 0);
+   EMIT(REG_DPU_RDMA_RDMA_FEATURE_MODE_CFG, DPU_RDMA_RDMA_FEATURE_MODE_CFG_BURST_LEN(15) |
+        DPU_RDMA_RDMA_FEATURE_MODE_CFG_FLYING_MODE(1));
