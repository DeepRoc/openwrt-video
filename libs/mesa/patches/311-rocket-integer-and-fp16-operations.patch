+      DBG("SHARED_GUARDS checked=%u intact\n",checked);
+   }
+   if (getenv("ROCKET_PROFILE")) fprintf(stderr,"PROFILE_OUTPUT ns=%lu\n",rkt_profile_ns()-profile_start);
+   ml_failed(pcontext,subgraph);
    DBG("Processed output\n");
 }
 
 static void
 free_operation(struct rkt_operation *operation)
 {
+   pipe_resource_reference(&operation->conv_side, NULL);
+   pipe_resource_reference(&operation->aux_scratch, NULL);
+   pipe_resource_reference(&operation->conv_prelu, NULL);
+   pipe_resource_reference(&operation->conv_input, NULL);
+   pipe_resource_reference(&operation->conv_output, NULL);
    util_dynarray_fini(&operation->tasks);
    pipe_resource_reference(&operation->regcmd, NULL);
    pipe_resource_reference(&operation->weights, NULL);
    pipe_resource_reference(&operation->biases, NULL);
+   pipe_resource_reference(&operation->pool_scratch, NULL);
 }
 
