+            rkt_dump_buffer(map, "input", input_idxs[i], 0, 0,
+                            rkt_get_tensor(subgraph, input_idxs[i])->bo_size);
+
+         DBG("Converted data\n");
+
+         pipe_buffer_unmap(pcontext, transfer_out);
+      }
+   }
+   DBG("Processed input\n");
+
+   submit_operations(pcontext, subgraph, util_dynarray_begin(&subgraph->operations),
+                     util_dynarray_num_elements(&subgraph->operations, struct rkt_operation));
+   ml_failed(pcontext,subgraph);
