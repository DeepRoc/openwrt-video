+/* Nearest x2 is a direct INT8 transposed convolution with diagonal 2x2
+ * unit weights. Operate on raw signed codes: no requantization is needed. */
+static void
+lower_resize(struct rkt_ml_subgraph *sg, const struct pipe_ml_operation *p,
+             struct rkt_operation *op)
+{
+   unsigned channels = p->input_tensors[0]->dims[3];
+   int8_t *weights = calloc(channels * channels * 4, 1);
+   int32_t *biases = calloc(channels, sizeof(int32_t));
+   for (unsigned c = 0; c < channels; c++)
+      for (unsigned k = 0; k < 4; k++)
+         weights[(c * 4 + k) * channels + c] = 1;
+   struct pipe_tensor in = *p->input_tensors[0], out = *p->output_tensors[0];
+   in.scale = out.scale = 1;
+   in.zero_point = out.zero_point = 0;
+   struct pipe_tensor wt = { .dims = {channels, 2, 2, channels},
+      .is_signed = true, .type_size = 1, .scale = 1, .data = (uint8_t *)weights };
+   struct pipe_tensor bt = { .dims = {1, 1, 1, channels},
+      .is_signed = true, .type_size = 4, .scale = 1, .data = (uint8_t *)biases };
+   struct pipe_tensor *inputs[] = {&in}, *outputs[] = {&out};
+   struct pipe_ml_operation conv = {0};
+   conv.type = PIPE_ML_OPERATION_TYPE_CONVOLUTION;
+   conv.input_tensors = inputs; conv.output_tensors = outputs;
+   conv.conv.weight_tensor = &wt; conv.conv.bias_tensor = &bt;
+   conv.conv.stride_x = conv.conv.stride_y = 1;
+   conv.conv.padding_top = conv.conv.padding_left = 1;
+   conv.conv.padding_bottom = conv.conv.padding_right = 1;
+   lower_convolution(sg, &conv, op);
+   op->deconv = true;
+   free(weights); free(biases);
+}
+
+static void
+lower_tensor_shape(const struct pipe_ml_operation *p, struct rkt_operation *op)
+{
+   const struct pipe_tensor *in = p->input_tensors[0], *out = p->output_tensors[0];
+   op->tasks = UTIL_DYNARRAY_INIT;
+   op->input_index = in->index;
+   op->input_width = in->dims[2];
+   op->input_height = in->dims[1];
+   op->input_channels = in->dims[3];
+   op->input_zero_point = in->zero_point + (in->is_signed ? 128 : 0);
+   op->input_scale = in->scale;
+   op->output_index = out->index;
+   op->output_width = out->dims[2];
+   op->output_height = out->dims[1];
+   op->output_channels = out->dims[3];
+   op->output_zero_point = out->zero_point + (out->is_signed ? 128 : 0);
+   op->output_scale = out->scale;
+}
+
+static void
+lower_pooling(const struct pipe_ml_operation *p, struct rkt_operation *op)
+{
+   lower_tensor_shape(p, op);
+   op->pooling = true;
+   op->pool_width = p->pooling.filter_width;
+   op->pool_height = p->pooling.filter_height;
+   op->stride = p->pooling.stride_x;
+   op->pool_stride_y = p->pooling.stride_y;
+   op->padding_left = p->pooling.padding_left;
+   op->padding_top = p->pooling.padding_top;
+   op->padding_right = p->pooling.padding_right;
+   op->padding_bottom = p->pooling.padding_bottom;
 }
 
