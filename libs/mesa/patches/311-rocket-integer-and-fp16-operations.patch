+
+/* Per-axis quantization. Register/layout reference (independently tested
+ * on this board before integration): gregordinary/rockchip-npu-notes,
+ * encodings/out-cvt-converter.md, per-axis BS multiplier section. */
+struct pipe_resource *
+rkt_fill_peraxis(struct rkt_ml_subgraph *subgraph,
+                 const struct pipe_ml_operation *pop,
+                 struct rkt_operation *op)
+{
+   struct pipe_context *ctx = subgraph->context;
+   unsigned channels = op->output_channels;
+   unsigned ic = op->input_channels;
+   unsigned area = op->weights_width * op->weights_height;
+   const int8_t *w = (const int8_t *)pop->conv.weight_tensor->data;
+   const int32_t *bias = (const int32_t *)pop->conv.bias_tensor->data;
+   const float *scales = pop->conv.weight_tensor->scales;
+   float max_scale = 0.0f;
+   int64_t max_bound = 0;
+   for (unsigned oc = 0; oc < channels; oc++) {
+      int64_t sum_abs = 0;
+      for (unsigned k = 0; k < area; k++) {
+         if (op->depthwise)
+            sum_abs += abs(w[k * channels + oc]);
+         else
+            for (unsigned c = 0; c < ic; c++)
+               sum_abs += abs(w[(oc * area + k) * ic + c]);
+      }
+      int64_t corr = calculate_bias_correction(subgraph, pop, oc, (void *)w);
+      max_bound = MAX2(max_bound, llabs((int64_t)bias[oc] - corr) + 128 * sum_abs);
+      max_scale = MAX2(max_scale, scales[oc]);
+   }
+   /* Optional, measured INT8 double-rounding route. Both BS and BN have
+    * signed 16-bit multipliers. Approximate TFLite's Q31 multiplier with
+    * 2*C*M, first round in BN, and perform the signed final rounding in
+    * OUT_CVT. Preparation only; no host correction during inference. */
+   unsigned double_c = 0;
+   if (channels == 1 && !op->relu) {
+      double real = (double)op->input_scale * scales[0] / op->output_scale;
+      int exponent;
+      double mantissa = frexp(real, &exponent);
+      int64_t target = llround(ldexp(mantissa, 31));
+      if (target == (1LL << 31)) { target /= 2; exponent++; }
+      if (real > 0 && real < 0.5 && exponent <= -1 && exponent >= -31) {
+         int64_t best = INT64_MAX;
+         for (unsigned c = (target + 65533) / 65534; c <= 32767; c++) {
+            unsigned m = (target + c) / (2 * c);
+            int64_t error = llabs(2 * (int64_t)c * m - target);
+            if (m <= 32767 && error < best) {
+               best = error; double_c = c; op->double_bn_mul = m;
+            }
+         }
+         op->double_out_shift = -exponent;
+      }
+   }
+   /* For multiple channels, normalize each mantissa in BS (Q15). BN reads
+    * dense int16 powers of two with NRDMA DATA_USE=4 and ALU bypassed.
+    * OUT_CVT then uses a common shift with ties away from zero. This matches
+    * CONV2D and scalar DW tails; do not apply it to the NEON DW blocks whose
+    * negative ties round upward. All bounds cover every possible INT8 input. */
+   bool signed_vector = !op->relu &&
+                        channels > 1 && (!op->depthwise || channels < 8);
+   unsigned *vector_c = signed_vector ? calloc(channels, sizeof(*vector_c)) : NULL;
+   unsigned *vector_m = signed_vector ? calloc(channels, sizeof(*vector_m)) : NULL;
+   int *exponents = signed_vector ? calloc(channels, sizeof(*exponents)) : NULL;
+   if (signed_vector && (!vector_c || !vector_m || !exponents)) {
+      free(vector_c); free(vector_m); free(exponents);
+      rkt_context(ctx)->error=ENOMEM; return NULL;
+   }
+   signed_vector = signed_vector && vector_c && vector_m && exponents;
+   int min_exp = 0;
+   for (unsigned oc = 0; signed_vector && oc < channels; oc++) {
+      double real = (double)op->input_scale * scales[oc] / op->output_scale;
+      double mantissa = frexp(real, &exponents[oc]);
+      vector_c[oc] = lround(ldexp(mantissa, 15));
+      signed_vector = real > 0 && real < 0.5 && exponents[oc] >= -31 &&
+                      vector_c[oc] > 0 && vector_c[oc] <= 32767;
+      min_exp = MIN2(min_exp, exponents[oc]);
+   }
+   for (unsigned oc = 0; signed_vector && oc < channels; oc++) {
+      int distance = exponents[oc] - min_exp;
+      signed_vector = distance >= 0 && distance < 15;
+      if (signed_vector) {
+         vector_m[oc] = 1u << distance;
+         signed_vector = max_bound * vector_m[oc] <= INT32_MAX;
+      }
+   }
+   if (signed_vector) {
+      op->double_bn_mul = 1;
+      op->double_bn_shift = 0;
+      op->double_out_shift = -min_exp;
+   }
+   /* BN adds at most 32768 in the compensated path. Reserve its headroom
+    * in the same worst-case accumulator bound used for BS. */
+   bool rounding = op->relu;
+
+   op->bs_shift = 0;
+   while ((max_bound * 32767 >> op->bs_shift) >
+          INT32_MAX - (rounding ? 32768 : 0))
+      op->bs_shift++;
+   if (double_c) {
+      op->bs_shift = 0;
+      while ((max_bound * double_c >> op->bs_shift) > INT32_MAX)
+         op->bs_shift++;
+      op->double_bn_shift = 30 - op->bs_shift;
+   }
+   if (signed_vector) op->bs_shift = 15;
+   op->weights_scale = ldexpf(max_scale / 32767.0f, op->bs_shift);
+   op->truncate_bits = 0;
+   unsigned bytes = align(channels, op->depthwise ? 64 : 32) / 8 * 64;
+   float common = (op->input_scale * op->weights_scale) / op->output_scale;
+   uint32_t bits = fui(common);
+   int shift = 141 - (bits >> 23);
+   unsigned m = ((bits >> 9) & 0x7fff) + 1;
+   if (m < (1u << 14)) m |= 1u << 14;
+   /* Keep the existing route outside the verified integer-converter range. */
+   rounding = rounding && isfinite(common) && common > 0.0f &&
+              shift >= 0 && shift <= 63 && m <= INT16_MAX;
+   for (unsigned oc = 0; rounding && oc < channels; oc++) {
+      double scale = (double)op->input_scale * scales[oc] / op->output_scale;
+      double c = scale * ldexp(1.0, op->bs_shift + shift) / m;
+      rounding = isfinite(scale) && scale > 0.0 && scale < 0.5 &&
+                 c >= 0.0 && c < 32767.5;
+   }
+   op->rounding_offset = rounding ? bytes : 0;
+   if (rounding)
+      bytes += align(channels, op->depthwise ? 64 : 32) * 4;
+   if (signed_vector) {
+      op->bn_vector_offset = bytes;
+      bytes += align(channels, 64) * 2;
+   }
+   struct pipe_resource *res = pipe_buffer_create(ctx->screen, 0, PIPE_USAGE_DEFAULT, bytes);
+   struct pipe_transfer *transfer;
+   if (!res) { free(vector_c); free(vector_m); free(exponents); rkt_context(ctx)->error=ENOMEM; return NULL; }
+   uint8_t *map = pipe_buffer_map(ctx, res, PIPE_MAP_WRITE, &transfer);
+   if (!map) { free(vector_c); free(vector_m); free(exponents); pipe_resource_reference(&res,NULL); return NULL; }
+   memset(map, 0, bytes);
+   for (unsigned oc = 0; oc < channels; oc++) {
+      unsigned base = (oc / 8) * 64;
+      int32_t a = bias[oc] - calculate_bias_correction(subgraph, pop, oc, (void *)w);
+      if (op->bn_vector_offset) {
+         int16_t multiplier = signed_vector ? vector_m[oc] : op->double_bn_mul;
+         memcpy(map + op->bn_vector_offset + oc * 2, &multiplier, 2);
+      }
+      int16_t c = (int16_t)lroundf(scales[oc] / max_scale * 32767.0f);
+      if (double_c) c = double_c;
+      if (signed_vector) c = vector_c[oc];
+      memcpy(map + base + (oc % 8) * 4, &a, 4);
+      memcpy(map + base + 48 + (oc % 8) * 2, &c, 2);
+      if (rounding) {
+         double channel_scale = (double)op->input_scale * scales[oc] / op->output_scale;
+         /* Derive the channel coefficient from the actual emitted common gain,
+          * avoiding two independent approximations of the same scale. */
+         c = lround(channel_scale * ldexp(1.0, op->bs_shift + shift) / m);
+         memcpy(map + base + 48 + (oc % 8) * 2, &c, 2);
+         int exponent;
+         frexp(channel_scale, &exponent);
+         double half_step = exponent < 0 ? ldexp(1.0, exponent - 1) : 0.0;
+         int32_t delta = lround(half_step * ldexp(1.0, shift) / m);
+         /* For nonnegative accumulators, two rounds with final right shift r
+          * equal a single round after adding 2^(-r-1) in output units (apart
+          * from exact ties). BN adds that constant in BS-output units. ReLU
+          * makes the negative branch irrelevant; do not apply this to signed
+          * outputs without ReLU, whose TFLite rounding depends on the kernel.
+          * No weights or model biases are changed. */
+         memcpy(map + op->rounding_offset + oc * 4, &delta, 4);
+      }
+   }
+   if (signed_vector) DBG("SIGNED_DOUBLE output=%u channels=%u bs=%u out=%u\n", op->output_index, channels, op->bs_shift, op->double_out_shift);
+   free(vector_c); free(vector_m); free(exponents);
+   if (double_c) DBG("DOUBLE output=%u C=%u M=%u bs=%u bn=%u out=%u\n", op->output_index, double_c, op->double_bn_mul, op->bs_shift, op->double_bn_shift, op->double_out_shift);
+   if (DBG_ENABLED(ROCKET_DBG_DUMP_BOS))
+      rkt_dump_buffer(map, "peraxis", op->output_index, 0, 0, bytes);
+   pipe_buffer_unmap(ctx, transfer);
+   DBG("PERAXIS output=%u channels=%u shift=%u max_bound=%lld max_scale=%.9g\n",
+           op->output_index, channels, op->bs_shift, (long long)max_bound, max_scale);
+   return res;
+}
