+static bool
+ml_failed(struct pipe_context *ctx, struct rkt_ml_subgraph *s)
+{
+   util_dynarray_foreach(&s->operations,struct rkt_operation,o)
+      if (o->error) rkt_context(s->context)->error = o->error;
+   int error=rkt_context(ctx)->error ? rkt_context(ctx)->error : rkt_context(s->context)->error;
+   rkt_context(ctx)->error=error;
+   rkt_context(s->context)->error=error;
+   return error != 0;
+}
