+      a->dims[0]!=1 || a->dims[1]!=1 || !a->dims[2] || a->dims[2]>160 ||
+      !a->dims[3] || a->dims[3]>128 || b->dims[3]!=1) return false;
+   for(unsigned d=0;d<3;d++) if(a->dims[d]!=b->dims[d]) return false;
