+/* Correctness-first bridge: only format conversion/copies occur on the host.
+ * READ maps wait for the producer fence before unpacking or repacking. Keep
+ * logical buffers distinct from private DMA layouts, including fan-out/ADD.
+ */
+static void
+invoke_float_pipeline(struct pipe_context *ctx, struct rkt_ml_subgraph *s,
+                      unsigned count, unsigned indices[], void *inputs[])
