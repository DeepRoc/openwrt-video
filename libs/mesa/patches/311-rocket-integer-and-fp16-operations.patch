+   if(kind==RKT_FLOAT_ADD || kind==RKT_FLOAT_MUL || kind==RKT_FLOAT_SUB || kind==RKT_FLOAT_SQUARED_DIFF || kind==RKT_FLOAT_DIV) {
+      if(p->input_count!=2 || !fp32(p->input_tensors[1]) || (kind==RKT_FLOAT_ADD && p->add.relu)) return false;
+      const struct pipe_tensor *side=p->input_tensors[1];
+      for(unsigned d=0;d<4;d++) {
