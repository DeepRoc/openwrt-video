Subject: [PATCH] rocket: handle resource mapping and context errors

--- a/src/gallium/drivers/rocket/rkt_device.c
+++ b/src/gallium/drivers/rocket/rkt_device.c
@@ -9,6 +9,7 @@
 #include "drm-uapi/rocket_accel.h"
 
 #include <xf86drm.h>
+#include <errno.h>
 #include "util/os_mman.h"
 #include "util/ralloc.h"
 #include "util/u_inlines.h"
@@ -72,7 +73,10 @@
    assert(box->height == 1);
    assert(box->depth == 1);
 
+   *out_transfer = NULL;
+   if (rkt_context(pctx)->error) return NULL;
    struct rkt_transfer *transfer = rzalloc(NULL, struct rkt_transfer);
+   if (!transfer) { rkt_context(pctx)->error = ENOMEM; return NULL; }
    transfer->base.level = level;
    transfer->base.usage = usage;
    transfer->base.box = *box;
@@ -83,16 +87,44 @@
    arg.timeout_ns = INT64_MAX;
 
    ret = drmIoctl(screen->fd, DRM_IOCTL_ROCKET_PREP_BO, &arg);
-   assert(ret != -1);
-
-   uint8_t *map = os_mmap(NULL, prsc->width0, PROT_READ | PROT_WRITE, MAP_SHARED,
-                          screen->fd, rsc->fake_offset);
-   assert(map != MAP_FAILED);
+   if (ret < 0) {
+      rkt_context(pctx)->error = errno ? errno : EIO;
+      fprintf(stderr,"rocket: PREP_BO handle=%u failed: %s\n",arg.handle,strerror(rkt_context(pctx)->error));
+      pipe_resource_reference(&transfer->base.resource,NULL);
+      ralloc_free(transfer);
+      *out_transfer=NULL;
+      return NULL;
+   }
+
+   uint8_t *map;
+   if (rsc->persistent_map) {
+      simple_mtx_lock(&rsc->map_lock);
+      if (!rsc->cpu_map) {
+         rsc->cpu_map = os_mmap(NULL, prsc->width0, PROT_READ | PROT_WRITE,
+                                MAP_SHARED, screen->fd, rsc->fake_offset);
+         if (rsc->cpu_map == MAP_FAILED) {
+            rkt_context(pctx)->error = errno ? errno : ENOMEM;
+            rsc->cpu_map = NULL;
+            simple_mtx_unlock(&rsc->map_lock);
+            goto fail_map;
+         }
+      }
+      map = rsc->cpu_map;
+      simple_mtx_unlock(&rsc->map_lock);
+   } else {
+      map = os_mmap(NULL, prsc->width0, PROT_READ | PROT_WRITE,
+                    MAP_SHARED, screen->fd, rsc->fake_offset);
+      if (map == MAP_FAILED) { rkt_context(pctx)->error = errno ? errno : ENOMEM; goto fail_map; }
+   }
 
    transfer->map = map;
    *out_transfer = &transfer->base;
 
    return map + box->x;
+fail_map:
+   pipe_resource_reference(&transfer->base.resource, NULL);
+   ralloc_free(transfer);
+   return NULL;
 }
 
 static void
@@ -107,15 +139,22 @@
 
    arg.handle = rsrc->handle;
 
-   if (transfer->base.usage == PIPE_MAP_WRITE) {
+   if (transfer->base.usage & PIPE_MAP_WRITE) {
       ret = drmIoctl(screen->fd, DRM_IOCTL_ROCKET_FINI_BO, &arg);
-      assert(ret >= 0);
-   }
-
-   os_munmap(transfer->map, transfer->base.resource->width0);
+      if (ret < 0) rkt_context(pctx)->error=errno ? errno : EIO;
+   }
+
+   if (!rsrc->persistent_map)
+      os_munmap(transfer->map, transfer->base.resource->width0);
 
    pipe_resource_reference(&transfer->base.resource, NULL);
    ralloc_free(transfer);
+}
+
+static enum pipe_reset_status
+rkt_get_device_reset_status(struct pipe_context *pctx)
+{
+   return rkt_context(pctx)->error ? PIPE_UNKNOWN_CONTEXT_RESET : PIPE_NO_RESET;
 }
 
 static struct pipe_context *
@@ -123,15 +162,15 @@
                    void *priv, unsigned flags)
 {
    struct rkt_context *ctx = rzalloc(NULL, struct rkt_context);
+   if (!ctx)
+      return NULL;
    struct pipe_context *pctx = &ctx->base;
-
-   if (!ctx)
-      return NULL;
 
    pctx->screen = screen;
    pctx->priv = priv;
 
    pctx->destroy = rkt_destroy_context;
+   pctx->get_device_reset_status = rkt_get_device_reset_status;
 
    pctx->buffer_map = rkt_buffer_map;
    pctx->buffer_unmap = rkt_buffer_unmap;
@@ -163,6 +202,8 @@
    if (!rsc)
       return NULL;
 
+   simple_mtx_init(&rsc->map_lock, mtx_plain);
+   rsc->persistent_map = true;
    rsc->base = *templat;
    rsc->base.screen = pscreen;
    rsc->base.nr_samples = templat->nr_samples;
@@ -189,6 +230,7 @@
    return &rsc->base;
 
 free_rsc:
+   simple_mtx_destroy(&rsc->map_lock);
    ralloc_free(rsc);
    return NULL;
 }
@@ -203,6 +245,8 @@
    int ret;
 
    arg.handle = rsc->handle;
+   if (rsc->cpu_map) os_munmap(rsc->cpu_map, rsc->base.width0);
+   simple_mtx_destroy(&rsc->map_lock);
 
    ret = drmIoctl(screen->fd, DRM_IOCTL_GEM_CLOSE, &arg);
    assert(ret >= 0);
--- a/src/gallium/drivers/rocket/rkt_device.h
+++ b/src/gallium/drivers/rocket/rkt_device.h
@@ -8,6 +8,7 @@
 #include "pipe/p_state.h"
 #include "renderonly/renderonly.h"
 #include "util/log.h"
+#include "util/simple_mtx.h"
 #include "util/macros.h"
 
 #ifndef RKT_SCREEN_H
@@ -64,6 +65,7 @@
 
 struct rkt_context {
    struct pipe_context base;
+   int error; /* Sticky execution failure: never publish invalid output. */
 };
 
 static inline struct rkt_context *
@@ -80,6 +82,9 @@
    uint64_t obj_addr;
    uint64_t fake_offset;
    uint64_t bo_size;
+   bool persistent_map;
+   uint8_t *cpu_map;
+   simple_mtx_t map_lock;
 };
 
 static inline struct rkt_resource *
